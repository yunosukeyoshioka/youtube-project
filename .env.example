# Required: powers ideation, research synthesis, scriptwriting, marketing
# copy, and the improvement/insights loop.
ANTHROPIC_API_KEY=

# Optional: real web search for the research stage (set providers.research:
# tavily in config.yaml to use it). Without this, research falls back to the
# LLM's own knowledge.
TAVILY_API_KEY=

# Optional: higher quality narration (set providers.tts: elevenlabs).
# Without this, TTS falls back to espeak-ng (offline) or gTTS.
ELEVENLABS_API_KEY=

# Optional: AI-generated scene art and thumbnails instead of the free local
# renderer (set providers.image: openai).
OPENAI_API_KEY=
